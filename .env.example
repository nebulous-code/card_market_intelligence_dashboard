# Database — Neon connection string
# Get this from your Neon project dashboard: https://neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/pokemon_cards?sslmode=require

# Frontend — base URL for API requests
VITE_API_BASE_URL=http://localhost:8151

# API — origin allowed through CORS, in addition to the localhost ports
# hardcoded for local development. Set this to the deployed frontend URL.
FRONTEND_URL=

# API — whether the session cookie carries the Secure flag. Leave unset
# (defaults to true) anywhere served over HTTPS. Set to false only for
# plain-HTTP local development, where a Secure cookie is never stored.
# This also selects SameSite: none when secure, lax when not.
SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------------------
# Upload resource caps (all optional; defaults shown)
#
# Sized against measured behaviour rather than guessed. openpyxl's
# in-memory model costs ~8x the uncompressed XML, so MAX_UNCOMPRESSED_BYTES
# is what actually bounds memory -- 8 MB caps it near 64 MB. A malformed
# value here falls back to the default rather than raising, so a typo
# cannot take the API down or widen a limit to zero.
# ---------------------------------------------------------------------

# Largest accepted request body.
MAX_UPLOAD_BYTES=5242880

# Largest total size a workbook may expand to when opened. The primary
# defence against a zip decompression bomb.
MAX_UNCOMPRESSED_BYTES=8388608

# Reject a workbook that expands more than this many times. Real
# collection workbooks sit around 15x.
MAX_COMPRESSION_RATIO=100

# Reject an archive containing more parts than this.
MAX_ZIP_MEMBERS=1000

# Reject a sheet with a used range taller than this. A deliberate
# product limit rather than a technical one: card resolution is a single
# batched query regardless of row count, so the remaining constraint is
# openpyxl memory (see MAX_UNCOMPRESSED_BYTES, ~20,000 rows). 2,000 is a
# very large personal collection. Raise it freely if that changes.
MAX_DATA_ROWS=2000

# ---------------------------------------------------------------------
# Rate limiting on the three write endpoints (optional; defaults shown)
#
# Abuse control, not authentication -- client identity comes from
# X-Forwarded-For, which a caller can set. Reads are never limited.
# ---------------------------------------------------------------------

RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=600

# PokemonPriceTracker — pricing data source (Milestone 2)
# Get your API key at https://www.pokemonpricetracker.com
POKEMON_PRICE_TRACKER_API_KEY=your_key_here

# Tier flags — controls what PokemonPriceTracker returns per card.
# Free tier (100 credits/day): set both to false.
# API tier ($9.99/mo, 20,000 credits/day): set to true for the initial backfill
# run, then revert to false for nightly snapshot runs.
PPT_INCLUDE_HISTORY=false
PPT_HISTORY_DAYS=180

# Set to true on API tier only — fetches eBay/PSA graded prices (+1 credit/card).
PPT_INCLUDE_EBAY=false

# Output directory for ad-hoc API scripts (ppt_api_get_set.ps1, etc.)
# Use an absolute path outside the repo to avoid committing API responses.
PPT_OUTPUT_DIR=C:\path\to\your\output\folder

